 * - Collection ops: forEach, take, drop, flatMap
 * 
 * Usage:
 *   using ArrayTools;
 *   var numbers = [1, 2, 3, 4, 5];
 *   var sum = numbers.reduce((acc, item) -> acc + item, 0);
 */
class ArrayTools {
    
    /**
     * Reduces array to single value using accumulator function
     * @param array The array to reduce

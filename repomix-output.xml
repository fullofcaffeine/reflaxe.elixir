		var isBasic = projectType == "basic" || projectType == "add-to-existing";
		
		// Create template context object
		return {
			PROJECT_NAME: projectName,
			PROJECT_NAME_SNAKE: projectNameSnake,
			PROJECT_MODULE: projectModule,

typedef User = {
    name: String,
    email: Option<String>
}

/**
 * Example service class showing Option usage patterns
 */
class UserService {
    
    static var users: Array<User> = [
        {name: "Alice", email: Some("alice@example.com")},
        {name: "Bob", email: None}
    ];
    
    public static function findUser(name: String): Option<User> {
        for (user in users) {
            if (user.name == name) {
                return Some(user);
            }
        }
        return None;

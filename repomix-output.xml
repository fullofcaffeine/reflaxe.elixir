	@$(MAKE) -f $(MAKEFILE_LIST) $(shell find $(TEST_DIR)/core -name compile.hxml -exec dirname {} \; | sed 's|$(TEST_DIR)/||' | sed 's|/|__|g' | sed 's|^|test-|' | tr '\n' ' ')


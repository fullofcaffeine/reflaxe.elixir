        return this.year;
    }

    /**
     * Get month 0-11 (Haxe standard API)
     */
    public inline function getMonth(): Int {
        // Convert from Elixir 1-based to Haxe 0-based
        return this.month - 1;
    }

    /**
     * Get day of month 1-31 (Haxe standard API)
     */

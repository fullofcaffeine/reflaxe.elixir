        // Test 4: Complex expression with case statement
        var dateStr = "2025-01-29T12:00:00Z";
        var parsedDate = untyped __elixir__("
            case DateTime.from_iso8601({0}) do
                {:ok, dt, _} -> dt
                _ -> DateTime.utc_now()
            end
        ", dateStr);
        trace("Parsed date: " + parsedDate);

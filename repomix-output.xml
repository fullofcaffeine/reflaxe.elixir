            switch(e2.expr) {
                case TBlock(exprs) if (exprs.length > 0):
                    trace('[LoopBuilder] Body is TBlock with ${exprs.length} expressions');
                    // Look for the pattern: var name = g.key; var hex = g.value;
                    for (i in 0...exprs.length) {

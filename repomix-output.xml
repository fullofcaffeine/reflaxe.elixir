sample_files=$(find test/snapshot -name "*.ex" -path "*/intended/*" | head -5)

for file in $sample_files; do
    echo -n "Testing $file... "
    # Create a temporary file to avoid module conflicts
    temp_file="/tmp/test_$(basename $file)"

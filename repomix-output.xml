 * var result = Task.await(task);
 * 
 * // With timeout
 * var task = Task.async(() -> slowOperation());
 * switch(Task.yieldWithTimeout(task, 5000)) {
 *     case null: trace("Timeout!");
 *     case Ok(value): trace("Got: " + value);

        var loopContext: LoopContext = {
            variableName: v.name,
            rangeMin: extractRangeMin(e1),
            rangeMax: extractRangeMax(e1),
            depth: 0,  // Will be set from context if available
            iteratorExpr: captureIteratorExpression(e1)

			echo "Re-running failed tests..."; \
			$(MAKE) -f $(MAKEFILE_LIST) $$failed; \
		else \
			echo "No failed tests to re-run"; \
		fi; \
	else \
		echo "No test results found. Run tests first."; \
	fi


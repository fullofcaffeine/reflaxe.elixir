        trace("Current time: " + currentTime);

        trace("\n=== Test 2: __elixir__ with parameter substitution ===");

        // Test 2: Single parameter - {0} should be substituted
        var name = "Alice";
        var greeting = untyped __elixir__("\"Hello, {0}!\"", name);

package phoenix.live_react.macros;

#if macro
import haxe.Json;
import haxe.macro.Context;
import phoenix.live_view.macros.LiveEventProtocolModel.LiveEventData;
import phoenix.live_view.macros.LiveEventProtocolModel.LiveEventFieldData;
import phoenix.live_view.macros.LiveEventProtocolModel.LiveEventFieldKind;
import phoenix.live_view.macros.LiveEventProtocolModel.LiveEventOrigin;
import phoenix.live_view.macros.LiveEventProtocolModel.LiveEventProtocolData;

using StringTools;

/**
 * Deterministic TypeScript projection for stock LiveReact client pushes.
 *
 * WHAT
 * - Renders event names, closed semantic input types, exact runtime validators,
 *   wire encoders, and helpers accepted by stock LiveReact's `pushEvent`.
 *
 * WHY
 * - A React boundary must not repeat event strings or payload keys that are
 *   already owned by a Haxe `@:liveEventProtocol` enum.
 *
 * HOW
 * - Consumes `LiveEventProtocolModel`, the same normalized model used by the
 *   Haxe browser companion and Elixir LiveView dispatcher.
 * - Admits only hook-origin events and closed built-in payload kinds whose
 *   TypeScript runtime checks can match the existing JS decoder honestly.
 * - Rejects raw payloads and custom codecs. Those require an application-owned
 *   TypeScript adapter rather than an unsafe `any`/`unknown` projection.
 */
class LiveReactEventProtocolTypeScript {
	public static inline final GENERATED_SIGNATURE = "Generated by PhoenixHx LiveReactEventProtocol. Do not edit.";

	public static function render(protocol:LiveEventProtocolData):String {
		validate(protocol);

		var lines = [
			'/* $GENERATED_SIGNATURE */',
			'export const LIVE_EVENT_PROTOCOL_HASH = ${quote(protocol.manifestHash)} as const',
			'export const LIVE_EVENT_PROTOCOL_MANIFEST = ${quote(protocol.manifest)} as const',
			"",
			"/** Structural subset accepted by stock LiveReact's broader pushEvent function. */",
			"export type LiveReactPushEvent = (",
			"  event: string,",
			"  payload: Record<string, unknown>,",
			") => unknown",
			"",
			"const hasOwn = (value: Record<string, unknown>, key: string): boolean =>",
			"  Object.prototype.hasOwnProperty.call(value, key)",
			"",
			"function expectRecord(value: unknown, label: string): Record<string, unknown> {",
			'  if (value === null || typeof value !== "object" || Array.isArray(value)) {',
			'    throw new Error(label + " must be an object")',
			"  }",
			"  return value as Record<string, unknown>",
			"}",
			"",
			"function expectExactKeys(",
			"  value: Record<string, unknown>,",
			"  required: readonly string[],",
			"  optional: readonly string[],",
			"  label: string,",
			"): void {",
			"  const allowed = new Set([...required, ...optional])",
			"  for (const key of Object.keys(value)) {",
			"    if (!allowed.has(key)) {",
			'      throw new Error(label + " has unexpected field " + key)',
			"    }",
			"  }",
			"  for (const key of required) {",
			"    if (!hasOwn(value, key)) {",
			'      throw new Error(label + " is missing field " + key)',
			"    }",
			"  }",
			"}"
		];
		appendDecoderHelpers(lines, protocol);

		for (event in protocol.events) {
			lines.push("");
			appendEvent(lines, protocol, event);
		}

		lines.push("");
		return lines.join("\n");
	}

	static function appendDecoderHelpers(lines:Array<String>, protocol:LiveEventProtocolData):Void {
		if (usesKind(protocol, "string")) {
			appendLines(lines, [
				"",
				"function expectString(value: unknown, label: string): string {",
				'  if (typeof value !== "string") {',
				'    throw new Error(label + " must be a string")',
				"  }",
				"  return value",
				"}"
			]);
		}
		if (usesKind(protocol, "integer")) {
			appendLines(lines, [
				"",
				"function expectInteger(value: unknown, label: string): number {",
				"  if (!Number.isInteger(value)) {",
				'    throw new Error(label + " must be an integer")',
				"  }",
				"  return value as number",
				"}"
			]);
		}
		if (usesKind(protocol, "boolean")) {
			appendLines(lines, [
				"",
				"function expectBoolean(value: unknown, label: string): boolean {",
				'  if (typeof value !== "boolean") {',
				'    throw new Error(label + " must be a boolean")',
				"  }",
				"  return value",
				"}"
			]);
		}
		if (usesKind(protocol, "number")) {
			appendLines(lines, [
				"",
				"function expectNumber(value: unknown, label: string): number {",
				'  if (typeof value !== "number") {',
				'    throw new Error(label + " must be a number")',
				"  }",
				"  return value",
				"}"
			]);
		}
		if (usesKind(protocol, "string-array")) {
			appendLines(lines, [
				"",
				"function expectStringArray(value: unknown, label: string): string[] {",
				'  if (!Array.isArray(value) || !value.every((item: unknown) => typeof item === "string")) {',
				'    throw new Error(label + " must be an array of strings")',
				"  }",
				"  return value as string[]",
				"}"
			]);
		}
		if (usesKind(protocol, "integer-array")) {
			appendLines(lines, [
				"",
				"function expectIntegerArray(value: unknown, label: string): number[] {",
				"  if (!Array.isArray(value) || !value.every((item: unknown) => Number.isInteger(item))) {",
				'    throw new Error(label + " must be an array of integers")',
				"  }",
				"  return value as number[]",
				"}"
			]);
		}
	}

	static function usesKind(protocol:LiveEventProtocolData, expected:String):Bool {
		for (event in protocol.events) {
			for (field in event.fields) {
				if (kindKey(field.kind) == expected) {
					return true;
				}
			}
		}
		return false;
	}

	static function kindKey(kind:LiveEventFieldKind):String {
		return switch (kind) {
			case WireString: "string";
			case WireInt: "integer";
			case WireBool: "boolean";
			case WireFloat: "number";
			case WireStringArray: "string-array";
			case WireIntArray: "integer-array";
			case RawPayload | CustomCodec(_, _) | Unsupported(_): "unsupported";
		};
	}

	static function appendLines(target:Array<String>, source:Array<String>):Void {
		for (line in source) {
			target.push(line);
		}
	}

	static function validate(protocol:LiveEventProtocolData):Void {
		for (event in protocol.events) {
			switch (event.origin) {
				case HookEvent:
				case TemplateEvent | SubmitEvent(_) | ChangeEvent(_):
					Context.error('LiveReact TypeScript projection supports hook-origin events only. ${protocol.enumPath}.${event.constructorName} is ${originLabel(event.origin)}; keep template/form events in their Phoenix HXX boundary or declare a dedicated hook protocol.',
						event.pos);
			}

			for (field in event.fields) {
				switch (field.kind) {
					case WireString | WireInt | WireBool | WireFloat | WireStringArray | WireIntArray:
					case RawPayload:
						unsupportedField(protocol, event, field,
							"raw/open payloads require an application-owned TypeScript validator");
					case CustomCodec(_, label):
						unsupportedField(protocol, event, field,
							'custom codec $label requires an application-owned TypeScript adapter with equivalent encode/decode behavior');
					case Unsupported(reason):
						unsupportedField(protocol, event, field, reason);
				}
			}
		}
	}

	static function unsupportedField(protocol:LiveEventProtocolData, event:LiveEventData, field:LiveEventFieldData, reason:String):Void {
		Context.error('Cannot project ${protocol.enumPath}.${event.constructorName}.${field.name} (${field.typeName}) into a type-safe LiveReact contract: $reason.',
			field.pos);
	}

	static function appendEvent(lines:Array<String>, protocol:LiveEventProtocolData, event:LiveEventData):Void {
		var inputName = event.constructorName + "Input";
		var label = protocol.enumPath + "." + event.constructorName;
		var constant = eventConstant(event.constructorName);
		var required = [for (field in event.fields) if (!field.optional) field.name];
		var optional = [for (field in event.fields) if (field.optional) field.name];

		lines.push('export const $constant = ${quote(event.eventName)} as const');
		if (event.fields.length == 0) {
			lines.push('export type $inputName = Readonly<Record<string, never>>');
		} else {
			lines.push('export interface $inputName {');
			for (field in event.fields) {
				lines.push('  readonly ${field.name}${field.optional ? "?" : ""}: ${typeScriptType(field)}');
			}
			lines.push("}");
		}

		lines.push("");
		lines.push('export function decode${event.constructorName}Input(value: unknown): $inputName {');
		lines.push('  const input = expectRecord(value, ${quote(label)})');
		lines.push("  expectExactKeys(");
		lines.push("    input,");
		lines.push('    ${stringArray(required)},');
		lines.push('    ${stringArray(optional)},');
		lines.push('    ${quote(label)},');
		lines.push("  )");
		if (event.fields.length == 0) {
			lines.push("  return {}");
		} else {
			lines.push("  return {");
			for (field in event.fields) {
				var raw = 'input[${quote(field.name)}]';
				var narrowed = '${decoder(field.kind)}($raw, ${quote(label + "." + field.name)})';
				var decoded = nullable(field) ? '$raw === null ? null : $narrowed' : narrowed;
				if (field.optional) {
					appendOptionalDecodedField(lines, field, raw, narrowed);
				} else {
					lines.push('    ${field.name}: $decoded,');
				}
			}
			lines.push("  }");
		}
		lines.push("}");

		lines.push("");
		if (event.fields.length == 0) {
			lines.push('export function encode${event.constructorName}Payload(): Record<string, unknown> {');
			lines.push("  return {}");
		} else {
			lines.push('export function encode${event.constructorName}Payload(input: $inputName): Record<string, unknown> {');
			lines.push("  return {");
			for (field in event.fields) {
				if (field.optional) {
					lines.push('    ...(input.${field.name} === undefined ? {} : {${propertyKey(field.wireName)}: input.${field.name}}),');
				} else {
					lines.push('    ${propertyKey(field.wireName)}: input.${field.name},');
				}
			}
			lines.push("  }");
		}
		lines.push("}");

		lines.push("");
		if (event.fields.length == 0) {
			lines.push('export function push${event.constructorName}(pushEvent: LiveReactPushEvent): void {');
			lines.push('  pushEvent($constant, encode${event.constructorName}Payload())');
		} else {
			lines.push('export function push${event.constructorName}(pushEvent: LiveReactPushEvent, candidate: $inputName): void {');
			lines.push('  const input = decode${event.constructorName}Input(candidate)');
			lines.push('  pushEvent($constant, encode${event.constructorName}Payload(input))');
		}
		lines.push("}");
	}

	static function appendOptionalDecodedField(lines:Array<String>, field:LiveEventFieldData, raw:String, narrowed:String):Void {
		lines.push('    ...(hasOwn(input, ${quote(field.name)})');
		lines.push("      ? {");
		if (nullable(field)) {
			lines.push('          ${field.name}:');
			lines.push('            $raw === null');
			lines.push("              ? null");
			lines.push('              : $narrowed,');
		} else {
			lines.push('          ${field.name}: $narrowed,');
		}
		lines.push("        }");
		lines.push("      : {}),");
	}

	static function typeScriptType(field:LiveEventFieldData):String {
		var base = switch (field.kind) {
			case WireString: "string";
			case WireInt | WireFloat: "number";
			case WireBool: "boolean";
			case WireStringArray: "string[]";
			case WireIntArray: "number[]";
			case RawPayload | CustomCodec(_, _) | Unsupported(_): "never";
		};
		return nullable(field) ? '$base | null' : base;
	}

	static function nullable(field:LiveEventFieldData):Bool {
		return field.typeName.startsWith("Null<") && field.typeName.endsWith(">");
	}

	static function decoder(kind:LiveEventFieldKind):String {
		return switch (kind) {
			case WireString: "expectString";
			case WireInt: "expectInteger";
			case WireBool: "expectBoolean";
			case WireFloat: "expectNumber";
			case WireStringArray: "expectStringArray";
			case WireIntArray: "expectIntegerArray";
			case RawPayload | CustomCodec(_, _) | Unsupported(_): "expectUnsupported";
		};
	}

	static function eventConstant(constructorName:String):String {
		var out = new StringBuf();
		for (index in 0...constructorName.length) {
			var char = constructorName.charAt(index);
			var alphaNumeric = (char >= "a" && char <= "z") || (char >= "A" && char <= "Z") || (char >= "0" && char <= "9");
			if (!alphaNumeric) {
				out.add("_");
				continue;
			}

			var uppercase = char >= "A" && char <= "Z";
			var previous = index == 0 ? "" : constructorName.charAt(index - 1);
			var next = index + 1 >= constructorName.length ? "" : constructorName.charAt(index + 1);
			var previousLowerOrDigit = (previous >= "a" && previous <= "z") || (previous >= "0" && previous <= "9");
			var nextLower = next >= "a" && next <= "z";
			if (uppercase && index > 0 && (previousLowerOrDigit || nextLower)) {
				out.add("_");
			}
			out.add(char.toUpperCase());
		}
		return out.toString() + "_EVENT";
	}

	static function originLabel(origin:LiveEventOrigin):String {
		return switch (origin) {
			case HookEvent: "hook-origin";
			case TemplateEvent: "template-origin";
			case SubmitEvent(root): 'submit-origin (root $root)';
			case ChangeEvent(root): 'change-origin (root $root)';
		};
	}

	static function stringArray(values:Array<String>):String {
		return "[" + [for (value in values) quote(value)].join(", ") + "]";
	}

	static function propertyKey(value:String):String {
		return ~/^[A-Za-z_$][A-Za-z0-9_$]*$/.match(value) ? value : quote(value);
	}

	static function quote(value:String):String {
		return Json.stringify(value);
	}
}
#end

# Haxe→Elixir compilation for ExUnit tests (MIX_ENV=test)

-lib reflaxe.elixir

# Compile test modules plus referenced app modules
-cp src_haxe
-cp test_haxe

# Emit test files into a dedicated location consumed by test/test_helper.exs
-D elixir_output=test/generated
-D elixir_output_exs

-D reflaxe_runtime
-D reflaxe_elixir_strict_examples
-D exunit
-D app_name=ElixirFirstLiveview

-dce full

live.SearchDomainTest
web.SearchLiveIntegrationTest

# Elixir-first LiveView example build configuration

-lib reflaxe.elixir

-cp src_haxe
-cp test_haxe

-D elixir_output=lib
-D reflaxe_runtime
-D reflaxe_elixir_strict
-D hxx_mode=tsx
-D exunit

-D app_name=ElixirFirstLiveview

ElixirFirstLiveview
live.SearchLive
live.SearchDomain
live.SearchDomainTest

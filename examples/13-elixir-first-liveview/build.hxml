# Elixir-first LiveView example build configuration

-lib reflaxe.elixir

-cp src_haxe

-D elixir_output=lib
-D reflaxe_runtime
-D reflaxe_elixir_strict
-D hxx_mode=tsx

-D app_name=ElixirFirstLiveview

ElixirFirstLiveview
live.SearchLive
live.SearchDomain
server.infrastructure.CoreComponents
server.infrastructure.Gettext
server.infrastructure.Layouts

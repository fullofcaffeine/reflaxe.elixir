# Reflaxe.Elixir Build Configuration
# Generated by mix haxe.gen.project
#
# Notes
# - `-lib reflaxe.elixir` initializes the compiler (via haxe_libraries/reflaxe.elixir.hxml).
# - Add the modules you want to compile at the bottom (one per line).

# Libraries
-lib reflaxe.elixir

# Source directories
-cp src_haxe

# Output directory for generated .ex files
-D elixir_output=lib

# Required for Reflaxe targets
-D reflaxe_runtime

# Elixir is not a UTF-16 platform
-D no-utf16

# Application module prefix
#
# IMPORTANT:
# In Phoenix projects, this should match the app's Elixir module prefix (e.g. PhoenixHxTodo)
# so framework transforms (Presence/Endpoint/Router/etc.) derive correct otp_app and PubSub modules.
-D app_name=PhoenixHxTodo

# Enable dead code elimination to remove unused functions and reduce output noise
-dce full

# Convert HXX render strings to `~H` sigils (recommended for LiveView)
-D hxx_string_to_sigil

PhoenixHxTodo
PhoenixHxTodoRouter
phoenix_hx_todo_hx.infrastructure.Repo
phoenix_hx_todo_hx.infrastructure.LiveSession
phoenix_hx_todo_hx.data.User
phoenix_hx_todo_hx.data.Todo
phoenix_hx_todo_hx.data.ChatMessage
phoenix_hx_todo_hx.contexts.Accounts
phoenix_hx_todo_hx.contexts.Todos
phoenix_hx_todo_hx.contexts.ChatMessages
phoenix_hx_todo_hx.controllers.SessionController
phoenix_hx_todo_hx.live.AppLive
phoenix_hx_todo_hx.live.TodoState
phoenix_hx_todo_hx.Main

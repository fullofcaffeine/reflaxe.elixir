-lib tink_macro
-lib tink_parse
# This app-local scoped entry overrides the repository entry, so it must carry
# the complete Reflaxe source-checkout classpath contract.
-cp ${SCOPE_DIR}/../../src/
-cp ${SCOPE_DIR}/../../std/
-cp ${SCOPE_DIR}/../../std/elixir/_std/
-cp ${SCOPE_DIR}/../../vendor/phoenix_shared/src
-D phoenix_shared=0.1.0
-lib reflaxe
-D reflaxe.elixir=0.0.0-development
--macro nullSafety("reflaxe.elixir")
--macro reflaxe.elixir.CompilerBootstrap.Start()
--macro reflaxe.elixir.CompilerInit.Start()

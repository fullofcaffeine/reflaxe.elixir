{
  "dependencies": {
    "live_react": "file:deps/live_react",
    "phoenix": "1.7.24",
    "phoenix_html": "4.3.0",
    "phoenix_live_view": "0.20.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "topbar": "2.0.0"
  },
  "description": "Elixir project with Reflaxe.Elixir support",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.32",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "lix": "^15.12.4",
    "nodemon": "^3.0.0",
    "typescript": "5.8.3",
    "vite": "7.2.7",
    "vitest": "3.2.4"
  },
  "name": "phoenix_chat",
  "private": true,
  "scripts": {
    "assets:build": "vite build",
    "assets:dev": "vite --host 127.0.0.1 --port 5173 --strictPort --logLevel warn",
    "compile": "haxe build.hxml",
    "setup:haxe": "npx lix download",
    "test": "mix test",
    "test:frontend": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "nodemon --watch src_haxe --ext hx --exec \"haxe build.hxml\""

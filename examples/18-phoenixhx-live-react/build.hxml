# Reflaxe.Elixir Build Configuration
# Generated by reflaxe.elixir (ProjectGenerator)
#
# Notes
# - `-lib reflaxe.elixir` loads the compiler + bootstrap macro via haxe_libraries/reflaxe.elixir.hxml.

# Libraries
-lib reflaxe.elixir

# Source directories
-cp src_haxe

# Output directory for generated .ex files
-D elixir_output=lib/phoenixhx_live_react_hx

# Elixir is not a UTF-16 platform
-D no-utf16

# Application module prefix
-D app_name=PhoenixhxLiveReact

# Optional canonical Mix formatting after code generation (off by default)
# -D reflaxe_elixir_format=write

# Enable dead code elimination to remove unused functions and reduce output noise
-dce full

-D hxx_string_to_sigil
--main phoenixhx_live_react_hx.Main

-cp .
-cp ../../../../src
-cp ../../../../std
-cp ../../../../std/elixir/_std
-lib reflaxe
-D reflaxe_runtime
-D phoenix_api_only
-D elixir_output=out
--macro reflaxe.elixir.CompilerInit.Start()
--macro keep('infrastructure.Endpoint')
--macro keep('infrastructure.Router')
--macro keep('infrastructure.UserSocket')
Main

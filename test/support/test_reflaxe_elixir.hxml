# Test-specific Reflaxe.Elixir Library Configuration
# 
# This configuration uses absolute paths to avoid issues with symlinks
# and the "35-file phenomenon" while ensuring tests can access the
# reflaxe.elixir compiler properly.
#

# Get the project root from environment variable set by test helper
# Include the compiler source code using absolute path
-cp ${REFLAXE_ELIXIR_PROJECT_ROOT}/src/

# Include the Elixir target APIs and stdlib definitions using absolute paths.
# Keep `_std` after `std` in hxml order so Haxe resolves upstream-colliding
# source overrides first in source-checkout test mode.
-cp ${REFLAXE_ELIXIR_PROJECT_ROOT}/std/
-cp ${REFLAXE_ELIXIR_PROJECT_ROOT}/std/elixir/_std/

# Depend on the base Reflaxe framework
-lib reflaxe

# Define the library version
-D reflaxe.elixir=0.14.22
# Bootstrap and initialize the Elixir compiler
--macro reflaxe.elixir.CompilerBootstrap.Start()
--macro reflaxe.elixir.CompilerInit.Start()
